# Gemini API Key (Google AI Studio) - Required for AI question & evaluation generation
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL - Required for PostgreSQL data persistence
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Server-Side Secret) - Required for DB access
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CORS Allowed Origins - Comma-separated frontend URLs
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
